# GateShield Landing Page Gmail SMTP Configuration (Server-Side Only)
# Copy this file to .env or configure directly in your server environment.
# NEVER commit real credentials or expose them via NEXT_PUBLIC_* variables.

EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=GateShield

# Designated GateShield business recipient email (falls back to CONTACT_RECIPIENT_EMAIL or SMTP_USER if unset)
ADMIN_NOTIFICATION_EMAIL=
